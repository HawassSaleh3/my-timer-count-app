                {
                    "src": "assets/icons/icon-add.png",
                    "sizes": "96x96",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "Settings",
            "short_name": "Settings",
            "description": "Open app settings",
            "url": "/#settings",
            "icons": [
                {
                    "src": "assets/icons/icon-settings.png",
                    "sizes": "96x96",
                    "type": "image/png"
                }
            ]
